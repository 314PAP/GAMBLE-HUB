rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.castka is number
        && request.resource.data.castka > 500
        && request.resource.data.castka <= 1000000000
        && request.resource.data.castka <= 50000;
      allow update: if request.auth != null
        && request.resource.data.castka is number
        && request.resource.data.castka > resource.data.castka
        && request.resource.data.castka <= 1000000000
        && request.resource.data.castka <= (resource.data.castka * 200 + 50000);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.username is string
        && request.resource.data.gameName is string
        && request.resource.data.bet is number
        && request.resource.data.bet > 0;
      allow update, delete: if false;
    }

    match /visits/{docId} {
      allow read, write: if true;
    }
  }
}
