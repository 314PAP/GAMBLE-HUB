/* 5. Layout základ – screen management, form inputs */
:root {
  /* Screen container sizes */
  --screen-max-width: 1440px;
  --screen-max-height: 900px;
}

:root {
  --screen-padding: clamp(8px, 2vw, 16px);
}

#app {
  width: 100%;
  max-width: calc(100% - var(--screen-padding) * 2);
  max-height: calc(100% - var(--screen-padding) * 2);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100%;
  max-width: var(--screen-max-width);
  max-height: var(--screen-max-height);
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.game-container {
  width: 100%;
  height: auto;
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: visible;
  box-sizing: border-box;
  padding: clamp(8px, 2vw, 16px);
}

.screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: clamp(8px, 2vw, 16px);
  overflow: hidden;
  box-sizing: border-box;
}

.screen.hidden {
  display: none;
}

.screen:not(.hidden) {
  display: flex;
}

input, textarea, select {
  font-family: 'Outfit', sans-serif;
  font-size: 1rem;
}

input[type="text"], input[type="number"], input[type="password"], textarea, select {
  background: rgba(0, 0, 0, 0.4);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 8px;
  color: var(--text-primary);
  padding: 0.75rem 1rem;
  width: 100%;
  max-width: 320px;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

input[type="text"]:focus, input[type="number"]:focus, input[type="password"]:focus, textarea:focus, select:focus {
  outline: none;
  border-color: var(--neon-yellow);
  box-shadow: 0 0 8px var(--neon-yellow-glow);
  background: rgba(0, 0, 0, 0.6);
}

input[type="checkbox"] {
  width: 1rem;
  height: 1rem;
  cursor: pointer;
}

/* Form labels */
label {
  font-size: 0.9rem;
  margin-bottom: 0.25rem;
  display: block;
  font-weight: 500;
  color: var(--text-secondary);
}

/* Ensure proper spacing in forms */
.form-group {
  margin-bottom: 1.25rem;
  width: 100%;
  max-width: 320px;
}

/* Screen management - screens should fill container */
.screen-container {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* Ensure containers don't overflow */
.container {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* Prevent horizontal scrolling */
html, body {
  overflow-x: hidden;
}

/* Full height containers */
.full-height {
  min-height: 100dvh;
  display: flex;
  flex-direction: column;
}

/* Grid background container */
.background-grid {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: -2;
  overflow: hidden;
}

/* Ensure grid stays within bounds */
.background-grid > div {
  position: absolute;
  inset: 0;
}